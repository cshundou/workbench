# =============================================================================
# AI Workbench 环境变量配置
# 使用方式: cp .env.example .env 后按需修改
# =============================================================================

# --- 应用基础 ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=ai-workbench
API_V1_PREFIX=/api/v1
LOG_DIR=logs

# --- 服务端口 ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_USER=ai_workbench
POSTGRES_PASSWORD=ai_workbench_secret
POSTGRES_DB=ai_workbench
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Docker Compose 内使用（服务名 postgres）
DATABASE_URL=postgresql+asyncpg://ai_workbench:ai_workbench_secret@postgres:5432/ai_workbench

# 本地手动开发时使用（取消注释并注释上一行）
# DATABASE_URL=postgresql+asyncpg://ai_workbench:ai_workbench_secret@localhost:5432/ai_workbench

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Docker Compose 内使用（服务名 redis）
REDIS_URL=redis://redis:6379/0

# 本地手动开发时使用（取消注释并注释上一行）
# REDIS_URL=redis://localhost:6379/0

# --- JWT 认证（字段名与 backend/app/core/config.py 一致）---
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS（JSON 数组格式）---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- OpenAI / GPT-4o ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- 通义千问 (DashScope) ---
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-max

# --- 豆包 (火山引擎) ---
VOLCENGINE_API_KEY=
VOLCENGINE_MODEL=doubao-pro-32k

# --- RAG: Cohere Rerank ---
COHERE_API_KEY=

# --- RAG: 向量存储 ---
CHROMA_PERSIST_DIRECTORY=./chroma_data
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-workbench
PINECONE_ENVIRONMENT=us-east-1

# --- Agent 工具: Tavily 联网搜索 ---
TAVILY_API_KEY=

# --- LangSmith 可观测 ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-workbench
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- 文件上传 ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- 接口限流 (Redis) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- 前端 (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_APP_TITLE=企业智能协作工作台
