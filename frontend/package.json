{
  "name": "ai-workbench-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,json,scss}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vue-flow/core": "^1.48.2",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.7.7",
    "echarts": "^5.6.0",
    "element-plus": "^2.8.4",
    "jsdom": "^25.0.1",
    "mammoth": "^1.8.0",
    "monaco-editor": "^0.47.0",
    "pdfjs-dist": "^4.8.69",
    "pinia": "^2.2.4",
    "vitest": "^2.1.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@unocss/reset": "^0.63.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.29.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "sass": "^1.80.3",
    "typescript": "^5.6.3",
    "unocss": "^0.63.4",
    "vite": "^5.4.9",
    "vue-tsc": "^2.1.6"
  },
  "lint-staged": {
    "*.{vue,ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss}": [
      "prettier --write"
    ]
  }
}
